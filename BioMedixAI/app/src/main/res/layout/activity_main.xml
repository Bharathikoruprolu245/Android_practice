<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BioMedix-AI"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI-Driven Drug Discovery &amp; CRISPR Design"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <!-- Disease -->

        <EditText
            android:id="@+id/diseaseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Disease name"
            android:text="lung cancer"
            android:inputType="text"
            android:padding="14dp"/>

        <!-- Species Dropdown -->

        <Spinner
            android:id="@+id/speciesSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="12dp"/>

        <!-- Guide RNA -->

        <EditText
            android:id="@+id/guideRnaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Guide RNA (required for CRISPR)"
            android:inputType="text"
            android:padding="14dp"
            android:layout_marginTop="14dp"/>

        <!-- Buttons -->

        <Button
            android:id="@+id/discoverButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Discover Targets"
            android:layout_marginTop="25dp"/>

        <Button
            android:id="@+id/druggabilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💊 Analyze Druggability"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/crisprButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧬 CRISPR Safety"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔬 Complete Analysis"
            android:layout_marginTop="12dp"/>

        <!-- Status -->

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:layout_marginTop="25dp"/>

        <!-- Result -->

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:padding="10dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>